<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="replace-submissions-task-id-with-task-assignment-id" author="Vladyslav Murashko">

        <delete tableName="submissions"/>

        <dropColumn
                tableName="submissions"
                columnName="task_id"/>

        <addColumn tableName="submissions">
            <column name="task_assignment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="submissions"
                baseColumnNames="task_assignment_id"
                referencedTableName="task_assignments"
                referencedColumnNames="id"
                constraintName="fk_submissions_task_assignments"/>

        <rollback>
            <dropForeignKeyConstraint
                    baseTableName="submissions"
                    constraintName="fk_submissions_task_assignments"/>

            <dropColumn
                    tableName="submissions"
                    columnName="task_assignment_id"/>

            <addColumn tableName="submissions">
                <column name="task_id" type="BIGINT"/>
            </addColumn>
        </rollback>

    </changeSet>

</databaseChangeLog>