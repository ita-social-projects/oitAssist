<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add-invitations-status-check" author="Serhiy Haleliuk">
        <sql dbms="postgresql">
            ALTER TABLE invitations
                ADD CONSTRAINT chk_invitation_status
                    CHECK (status IN ('PENDING', 'ACCEPTED', 'REJECTED', 'CANCELLED'));
        </sql>

        <rollback>
            <sql dbms="postgresql">
                ALTER TABLE invitations
                DROP CONSTRAINT chk_invitation_status;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="add-partial-unique-pending-index" author="Serhiy Haleliuk">
        <createIndex tableName="invitations"
                     indexName="idx_unique_pending_invitation"
                     unique="true">
            <column name="issued_by"/>
            <column name="competition_id"/>
            <column name="stage_id"/>
        </createIndex>

        <modifySql dbms="postgresql">
            <append value=" WHERE status = 'PENDING'"/>
        </modifySql>
    </changeSet>

    <changeSet id="add-invitations-read-index" author="Serhiy Haleliuk">
        <createIndex tableName="invitations" indexName="idx_invitations_competition_stage">
            <column name="competition_id"/>
            <column name="stage_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>