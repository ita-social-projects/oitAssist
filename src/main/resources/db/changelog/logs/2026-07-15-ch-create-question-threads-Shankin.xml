<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-question-threads-table" author="Ivan Shankin">
        <createTable tableName="question_threads">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_question_threads"
                        nullable="false"/>
            </column>

            <column name="task_assignment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="author_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="assigned_reviewer_id" type="BIGINT"/>

            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>

            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(32)" defaultValue="NEW">
                <constraints nullable="false"/>
            </column>

            <column name="state" type="VARCHAR(16)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>

            <column name="visibility" type="VARCHAR(16)" defaultValue="PRIVATE">
                <constraints nullable="false"/>
            </column>

            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="created_at"
                    type="TIMESTAMPTZ"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="question_threads"
                baseColumnNames="task_assignment_id"
                referencedTableName="task_assignments"
                referencedColumnNames="id"
                constraintName="fk_question_threads_task_assignment"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="question_threads"
                baseColumnNames="author_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_question_threads_author"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="question_threads"
                baseColumnNames="assigned_reviewer_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_question_threads_reviewer"
                onDelete="RESTRICT"/>

        <sql>
            ALTER TABLE question_threads
                ADD CONSTRAINT chk_question_threads_status
                    CHECK (status IN ('NEW', 'IN_REVIEW', 'ANSWERED'));

            ALTER TABLE question_threads
                ADD CONSTRAINT chk_question_threads_state
                    CHECK (state IN ('OPEN', 'CLOSED'));

            ALTER TABLE question_threads
                ADD CONSTRAINT chk_question_threads_visibility
                    CHECK (visibility IN ('PRIVATE', 'PUBLIC'));

            ALTER TABLE question_threads
                ADD CONSTRAINT chk_question_threads_version
                    CHECK (version >= 0);
        </sql>

        <rollback>
            <dropTable tableName="question_threads"/>
        </rollback>
    </changeSet>

    <changeSet id="create-question-threads-indexes" author="Ivan Shankin">
        <createIndex
                tableName="question_threads"
                indexName="idx_question_threads_assignment_visibility_created">
            <column name="task_assignment_id"/>
            <column name="visibility"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>

        <createIndex
                tableName="question_threads"
                indexName="idx_question_threads_author_created">
            <column name="author_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>

        <createIndex
                tableName="question_threads"
                indexName="idx_question_threads_reviewer_state_status_created">
            <column name="assigned_reviewer_id"/>
            <column name="state"/>
            <column name="status"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>

        <rollback>
            <dropIndex
                    tableName="question_threads"
                    indexName="idx_question_threads_reviewer_state_status_created"/>

            <dropIndex
                    tableName="question_threads"
                    indexName="idx_question_threads_author_created"/>

            <dropIndex
                    tableName="question_threads"
                    indexName="idx_question_threads_assignment_visibility_created"/>
        </rollback>
    </changeSet>

</databaseChangeLog>