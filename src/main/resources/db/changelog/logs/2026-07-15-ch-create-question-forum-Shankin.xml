<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-question-forum-tables" author="Ivan Shankin">
        <createTable tableName="question_threads">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_question_threads"
                        nullable="false"/>
            </column>

            <column name="task_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="author_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="assigned_reviewer_id" type="BIGINT"/>

            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>

            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(32)" defaultValue="NEW">
                <constraints nullable="false"/>
            </column>

            <column name="state" type="VARCHAR(16)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>

            <column name="visibility" type="VARCHAR(16)" defaultValue="PRIVATE">
                <constraints nullable="false"/>
            </column>

            <column name="status_before_close" type="VARCHAR(32)"/>

            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column
                    name="created_at"
                    type="TIMESTAMPTZ"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <createTable tableName="question_messages">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_question_messages"
                        nullable="false"/>
            </column>

            <column name="question_thread_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="author_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>

            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column
                    name="created_at"
                    type="TIMESTAMPTZ"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="question_threads"
                baseColumnNames="task_id"
                referencedTableName="task_bodies"
                referencedColumnNames="id"
                constraintName="fk_question_threads_task_body"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="question_threads"
                baseColumnNames="author_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_question_threads_author"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="question_threads"
                baseColumnNames="assigned_reviewer_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_question_threads_reviewer"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="question_messages"
                baseColumnNames="question_thread_id"
                referencedTableName="question_threads"
                referencedColumnNames="id"
                constraintName="fk_question_messages_thread"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="question_messages"
                baseColumnNames="author_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_question_messages_author"
                onDelete="RESTRICT"/>

        <sql>
            ALTER TABLE question_threads
                ADD CONSTRAINT chk_question_threads_status
                    CHECK (status IN ('NEW', 'IN_REVIEW', 'ANSWERED'));

            ALTER TABLE question_threads
                ADD CONSTRAINT chk_question_threads_state
                    CHECK (state IN ('OPEN', 'CLOSED'));

            ALTER TABLE question_threads
                ADD CONSTRAINT chk_question_threads_visibility
                    CHECK (visibility IN ('PRIVATE', 'PUBLIC'));

            ALTER TABLE question_threads
                ADD CONSTRAINT chk_question_threads_previous_status
                    CHECK (
                        status_before_close IS NULL
                            OR status_before_close IN ('NEW', 'IN_REVIEW', 'ANSWERED')
                        );

            ALTER TABLE question_threads
                ADD CONSTRAINT chk_question_threads_version
                    CHECK (version >= 0);

            ALTER TABLE question_messages
                ADD CONSTRAINT chk_question_messages_type
                    CHECK (type IN ('COMMENT', 'OFFICIAL_ANSWER'));
        </sql>

        <rollback>
            <dropTable tableName="question_messages"/>
            <dropTable tableName="question_threads"/>
        </rollback>
    </changeSet>

</databaseChangeLog>