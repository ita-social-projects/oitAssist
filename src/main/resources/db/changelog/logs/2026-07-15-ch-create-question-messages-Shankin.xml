<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-question-messages-table" author="Ivan Shankin">
        <createTable tableName="question_messages">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_question_messages"
                        nullable="false"/>
            </column>

            <column name="question_thread_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="author_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>

            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="created_at"
                    type="TIMESTAMPTZ"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="question_messages"
                baseColumnNames="question_thread_id"
                referencedTableName="question_threads"
                referencedColumnNames="id"
                constraintName="fk_question_messages_thread"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="question_messages"
                baseColumnNames="author_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_question_messages_author"
                onDelete="RESTRICT"/>

        <sql>
            ALTER TABLE question_messages
                ADD CONSTRAINT chk_question_messages_type
                    CHECK (type IN ('COMMENT','OFFICIAL_ANSWER'));
        </sql>

        <rollback>
            <dropTable tableName="question_messages"/>
        </rollback>
    </changeSet>

    <changeSet id="create-question-messages-indexes" author="Ivan Shankin">
        <createIndex
                tableName="question_messages"
                indexName="idx_question_messages_thread_created">
            <column name="question_thread_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>

        <createIndex
                tableName="question_messages"
                indexName="idx_question_messages_author_created">
            <column name="author_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>

        <rollback>
            <dropIndex
                    tableName="question_messages"
                    indexName="idx_question_messages_author_created"/>

            <dropIndex
                    tableName="question_messages"
                    indexName="idx_question_messages_thread_created"/>
        </rollback>
    </changeSet>

</databaseChangeLog>