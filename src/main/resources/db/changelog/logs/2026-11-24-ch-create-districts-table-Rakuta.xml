<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-districts-table" author="AnastasiaRakuta">
        <createTable tableName="districts">
            <column name="code" type="VARCHAR(10)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="region_code" type="VARCHAR(10)">
                <constraints nullable="false"
                             foreignKeyName="fk_districts_region"
                             references="regions(code)"/>
            </column>
        </createTable>

        <createIndex indexName="idx_districts_region_code" tableName="districts">
            <column name="region_code"/>
        </createIndex>

        <rollback>
            <dropTable tableName="districts"/>
        </rollback>
    </changeSet>

