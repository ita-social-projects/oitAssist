<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="alter-submissions" author="Vladyslav Murashko">

        <delete tableName="submissions"/>

        <dropColumn
                tableName="submissions"
                columnName="task_id"/>

        <dropForeignKeyConstraint
                baseTableName="submissions"
                constraintName="fk_submission_user"/>

        <renameColumn
                tableName="submissions"
                oldColumnName="user_id"
                newColumnName="submitted_by"
                columnDataType="BIGINT"/>

        <addForeignKeyConstraint
                baseTableName="submissions"
                baseColumnNames="submitted_by"
                constraintName="fk_submission_user"
                referencedTableName="users"
                referencedColumnNames="id"/>

        <addNotNullConstraint
                tableName="submissions"
                columnName="submitted_at"
                columnDataType="TIMESTAMPTZ"/>

        <addNotNullConstraint
                tableName="submissions"
                columnName="submitted_by"
                columnDataType="BIGINT"/>

        <addColumn tableName="submissions">
            <column name="task_assignment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="submissions"
                baseColumnNames="task_assignment_id"
                referencedTableName="task_assignments"
                referencedColumnNames="id"
                constraintName="fk_submission_task_assignment"/>

        <addUniqueConstraint
                tableName="submissions"
                columnNames="submitted_by, task_assignment_id"
                constraintName="uk_submission_user_task_assignment"/>

    </changeSet>

</databaseChangeLog>